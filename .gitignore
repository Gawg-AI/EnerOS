# ============================================================
# EnerOS / Power Native Agent OS — .gitignore
# 依据：开发管理记忆.md §三 垃圾文件与缓存治理
# ============================================================

# ===== 蓝图文档 =====
# Markdown 是后续开发的正式执行基线，需要进入版本控制；历史压缩备份仍留在本地。
蓝图/*
!蓝图/*.md
# ===== Rust / Cargo 构建产物 =====
target/
target-test-*/
ci/target-check/
**/*.rs.bk
*.rs.bk
rustc-ice-*.txt

# ===== seL4 构建产物 =====
build/
sel4-build/
sel4_kernel/
seL4/

# ===== 二进制镜像 / 编译产物 =====
*.elf
*.bin
*.img
*.hex
*.map
*.lst

# ===== 设备树二进制（源文件 .dts/.dtsi 入仓） =====
*.dtb
# WP-44 Exit：root-task driver_probe 测试 include_bytes! 此夹具（克隆构建
# 必需）；违例 .gitignore 强制跟踪（小型确定性测试输入）。
!crates/hal/board/tests/fixtures/qemu-virt.dtb

# ===== QEMU 产物 =====
qemu-output/
*.qcow2
*.img.qcow2
qemu-serial.log

# ===== 模型文件（用 Git LFS 或外部存储） =====
*.gguf
*.ggml
models/*.bin
*.onnx
*.pt
*.pth
*.safetensors

# ===== IDE 缓存 =====
.idea/
.vscode/
.trae/cache/
.trae/documents/
.trae/index/
.trae/tmp/
*.code-workspace
.project
.classpath
.settings/

# ===== 编辑器临时文件 =====
*.swp
*.swo
*~
*.tmp
*.bak
*.orig
*.rej

# ===== 操作系统垃圾 =====
.DS_Store
.DS_Store?
._*
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/
*.lnk

# ===== 密钥 / 凭证 / 敏感文件 =====
*.pem
*.key
*.p12
*.pfx
*.crt
*.cert
secrets/
.env
.env.*
!.env.example
*.pem.bak
id_rsa
id_rsa.pub
known_hosts

# ===== 日志 =====
*.log
logs/
log/

# ===== 测试覆盖率 / 性能分析产物 =====
tarpaulin-report.html
tarpaulin-report.json
coverage/
*.lcov
*.profdata
*.profraw
perf.data
perf.data.*
*.perf

# ===== Python 缓存（工具脚本用） =====
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/
.venv/
venv/

# ===== Node.js（若用文档工具） =====
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ===== Cargo.lock 策略 =====
# 本项目是二进制 crate，Cargo.lock 需入仓
# （如需忽略库 crate 的 lock，在子目录单独配置）

# ===== 本地开发配置（不入仓） =====
configs/local/
configs/*.local.toml
configs/*.local.json
Makefile.local

# ===== WSL / 虚拟机产物 =====
*.vhdx
*.vmdk
*.vdi

# ===== 调试产物 =====
core
core.*
*.core
dump.*
gdb-output.txt

# ===== 本地分析/临时产物（不入仓） =====
.clippy-*.txt
.codebuddy/
.redox-research/
.qoderignore

# ===== 第三方源码仓库（本地获取，不入仓） =====
third_party/highs-*/
third_party/llama.cpp/

# WP-44.5：临时产物与归档
archive/scratch-*/
*.rar

# 47（WP-47.3 私钥出仓）：本地密钥目录（永不入库；生成见 tools/gen-local-keys.sh）
product/security/keys-local/

# 介质不入库纪律：evidence 下 QEMU 磁盘镜像等 raw 介质留在本地不入仓
# （GitHub 单文件 100MiB 硬限；128MiB evidence/37 镜像已从未推送历史剥离，2026-08-29）
evidence/**/*.raw

# 过程产物与本地工具数据：本地保留，不上传（2026-08-29 GitHub 收口，677 文件已从历史剥离）
.reasonix/
.trae/
蓝图/
docs/delivery/
archive/
