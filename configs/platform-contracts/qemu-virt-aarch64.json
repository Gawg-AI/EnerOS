    { "kind": "qemu-source", "name": "QEMU hw/arm/virt.c (virt machine memory map)", "version": "8.2.2+" },
    { "kind": "manual", "name": "EnerOS qemu-prod profile", "version": "1.0.0" }
  ],
  "firmware": {
