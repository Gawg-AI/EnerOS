{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eneros.invalid/schema/test-result-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "suite_id", "artifact_sha256", "cases"],
  "properties": {
    "schema": { "const": "eneros.test-result.v1" },
    "suite_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
    "artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "cases": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "required", "status", "timed_out", "duration_ms"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]+$" },
          "required": { "type": "boolean" },
          "status": { "enum": ["PASS", "FAIL", "SKIPPED", "BLOCKED", "QUARANTINED"] },
          "timed_out": { "type": "boolean" },
          "duration_ms": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
