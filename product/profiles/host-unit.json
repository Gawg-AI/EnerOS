{
  "schema": "eneros.product-profile.v1",
  "id": "host-unit",
  "class": "test",
  "platform": "host",
  "target": "host",
  "image_layout": null,
  "artifacts": [
    "test-binaries"
  ],
  "binaries": [
    {
      "selector": "eneros-xtask::eneros-xtask",
      "role": "host-gate",
      "default_features": true,
      "features": []
