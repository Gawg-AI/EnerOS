{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eneros.invalid/schema/image-layout-v1.json",
  "title": "EnerOS deterministic GPT image layout v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "disk_size_bytes", "sector_size", "alignment_bytes", "disk_guid", "partitions"],
  "properties": {
    "schema": { "const": "eneros.image-layout.v1" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$" },
    "disk_size_bytes": { "type": "integer", "minimum": 33554432, "maximum": 17179869184 },
    "sector_size": { "enum": [512, 4096] },
    "alignment_bytes": { "type": "integer", "minimum": 4096, "maximum": 2097152 },
    "disk_guid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "partitions": {
      "type": "array",
      "minItems": 11,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "name", "type_guid", "size_bytes", "attributes"],
        "properties": {
          "role": {
            "enum": ["PLATFORM_BOOT", "BOOTCTRL", "BOOT_A", "BOOT_B", "SYS_A", "SYS_B", "RECOVERY", "CONFIG", "DATA", "LOGS", "MODELS"]
          },
          "name": { "type": "string", "pattern": "^[A-Z0-9_]{1,36}$" },
          "type_guid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
          "size_bytes": { "type": "integer", "minimum": 1048576, "maximum": 4294967296 },
          "attributes": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 }
        }
      }
    }
  }
}
