qemu-system-aarch64 -machine virt,gic-version=2,acpi=off -smp 4 -cpu cortex-a57 -m 1G -boot order=c -nographic -no-reboot -drive if=pflash,format=raw,readonly=on,file=/usr/share/AAVMF/AAVMF_CODE.secboot.fd -drive if=pflash,format=raw,file=/home/ahx/文档/EnerOS/target/evidence70-vol12/AAVMF_VARS.run.fd -drive if=none,format=raw,file=/home/ahx/文档/EnerOS/target/eneros/artifacts/qemu-test/eneros-qemu-test.raw,id=enerosdisk -device virtio-blk-device,bus=virtio-mmio-bus.0,drive=enerosdisk -object rng-random,filename=/dev/urandom,id=enerosrng -device virtio-rng-device,bus=virtio-mmio-bus.3,rng=enerosrng -drive if=none,format=raw,cache=none,file=/home/ahx/文档/EnerOS/target/evidence70-vol12/data-disk.raw,id=enerosdata -device virtio-blk-device,bus=virtio-mmio-bus.2,drive=enerosdata -netdev socket,id=enerosnet,listen=127.0.0.1:5577 -device virtio-net-device,bus=virtio-mmio-bus.1,netdev=enerosnet -netdev user,id=enerosnet8 -device virtio-net-device,bus=virtio-mmio-bus.8,netdev=enerosnet8 -netdev user,id=enerosnet9 -device virtio-net-device,bus=virtio-mmio-bus.9,netdev=enerosnet9 -netdev user,id=enerosnet10 -device virtio-net-device,bus=virtio-mmio-bus.10,netdev=enerosnet10 -netdev user,id=enerosnet11 -device virtio-net-device,bus=virtio-mmio-bus.11,netdev=enerosnet11 -netdev socket,id=enerosnet13,listen=127.0.0.1:5582 -device virtio-net-device,bus=virtio-mmio-bus.13,netdev=enerosnet13