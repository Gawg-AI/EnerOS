*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/
.venv/
venv/

# ===== Node.js（若用文档工具） =====
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ===== Cargo.lock 策略 =====
