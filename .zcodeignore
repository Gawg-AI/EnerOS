.clippy-*.txt
.codebuddy/
.redox-research/
.qoderignore

# ===== 第三方源码仓库（本地获取，不入仓） =====
third_party/highs-*/
third_party/llama.cpp/

# WP-44.5：临时产物与归档
archive/scratch-*/
*.rar

# 47（WP-47.3 私钥出仓）：本地密钥目录（永不入库；生成见 tools/gen-local-keys.sh）
product/security/keys-local/
product/tls/
product/station/

# 介质不入库纪律：evidence 下 QEMU 磁盘镜像等 raw 介质留在本地不入仓
# （GitHub 单文件 100MiB 硬限；128MiB evidence/37 镜像已从未推送历史剥离，2026-08-29）
evidence/**/*.raw
# 61 复查 fixverify：注入逐请求 transcript 达介质级体量（四份共 ~130MB）——
# manifest + CHECKSUMS.sha256 入库可校验，transcript 本地保留（2026-08-30）
evidence/61/phase0-fixverify/*.modbus.transcript.jsonl

# 过程产物与本地工具数据：本地保留，不上传（2026-08-29 GitHub 收口，677 文件已从历史剥离）
.reasonix/
.trae/
蓝图/
docs/delivery/
archive/

